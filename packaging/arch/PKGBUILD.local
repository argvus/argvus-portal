# Maintainer: William C. Canin
pkgname=argvus-portal
pkgver=0.1.0
pkgrel=1
pkgdesc="Wayland, DBus and portal integration defaults for the ARGVUS desktop."
arch=('any')
url="https://github.com/argvus/argvus-portal"
license=('GPL-3.0-only')
depends=('argvus-session' 'xdg-desktop-portal' 'xdg-desktop-portal-hyprland' 'xdg-desktop-portal-gtk')
options=('!debug')
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=("SKIP")

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" PREFIX=/usr install
}

